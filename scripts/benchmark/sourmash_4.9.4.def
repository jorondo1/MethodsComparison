# Apptainer recipe: sourmash 4.9.4 + the branchwater plugin 0.9.15 (fastgather, multithreaded).
# Fallback when no BioContainers image of the plugin can be pulled directly (see doc/HANDOFF.md).
# Build (compute node, needs network): apptainer build --fakeroot sourmash.4.9.4.sif scripts/benchmark/sourmash_4.9.4.def

Bootstrap: docker
From: quay.io/biocontainers/sourmash:4.9.4--hdfd78af_0

%post
    # The plugin ships prebuilt Linux wheels (Rust), so no compiler is needed. Pinned so the build is reproducible.
    # --no-deps: sourmash 4.9.4 is already in the image; pip must not replace it.
    python -m pip install --no-cache-dir --no-deps sourmash_plugin_branchwater==0.9.15

%test
    sourmash --version
    sourmash scripts fastgather --help > /dev/null

%labels
    sourmash 4.9.4
    sourmash_plugin_branchwater 0.9.15
